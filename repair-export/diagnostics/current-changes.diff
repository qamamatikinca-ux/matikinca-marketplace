diff --git a/app/globals.css b/app/globals.css
index e7ba2e2..57b83d3 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -396,3 +396,64 @@ html[data-loadlink-theme] img.loadlink-logo-img {
     forced-color-adjust: none;
   }
 }
+
+/* LOADLINK RECOVERY: reference scale, stable cards and modern messages */
+html { font-size: 16px !important; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
+body { min-width: 0; overflow-x: hidden; }
+.loadlink-logo-wrap { width: clamp(128px, 31vw, 184px); max-width: 100%; }
+.loadlink-logo-img { display:block; width:100%; height:auto; object-fit:contain; }
+
+/* Keep the menu at the original reference proportions. */
+[data-loadlink-menu-panel] { width:min(88vw,390px) !important; }
+[data-loadlink-menu-panel] [class*="min-h-[118px]"] { min-height:104px !important; }
+[data-loadlink-menu-panel] h2 { text-wrap:balance; }
+
+/* Eliminate stretched listing media/black filler. */
+[id^="job-"] > [role="button"] { height:auto !important; min-height:0 !important; align-self:start; }
+[id^="job-"] > [role="button"] > div:first-child { aspect-ratio:16/10; height:auto !important; min-height:0 !important; }
+[id^="job-"] > [role="button"] img { display:block; width:100%; height:100%; object-fit:cover; }
+
+/* Mobile chat must occupy exactly the current viewport, not a stale visualViewport height. */
+.loadlink-messages { position:relative !important; inset:auto !important; min-height:100svh !important; height:100dvh !important; max-height:100dvh; }
+.loadlink-messages .loadlink-chat-panel { min-height:0; height:100%; overflow:hidden; }
+.loadlink-message-viewport { position:relative; isolation:isolate; background:transparent; }
+.loadlink-message-viewport > *:not(.loadlink-message-sketch) { position:relative; z-index:1; }
+.loadlink-messages img.rounded-full,
+.loadlink-messages [class*="rounded-full"] > img { aspect-ratio:1/1 !important; border-radius:9999px !important; object-fit:cover !important; }
+
+/* Remove Safari/Chromium's blue native datalist indicator without removing suggestions. */
+input[list]::-webkit-calendar-picker-indicator { opacity:0 !important; display:none !important; }
+
+.loadlink-message-sketch { position:absolute; inset:0; z-index:0; overflow:hidden; color:currentColor; opacity:.055; pointer-events:none; }
+html[data-loadlink-theme="light"] .loadlink-message-sketch { opacity:.045; }
+.loadlink-message-sketch .loadlink-truck-sketch { position:absolute; width:min(520px,82vw); right:-8%; bottom:8%; transform:rotate(-4deg); }
+.loadlink-message-sketch[data-scene="1"] .loadlink-truck-sketch,
+.loadlink-message-sketch[data-scene="6"] .loadlink-truck-sketch { left:-8%; right:auto; transform:rotate(3deg) scaleX(-1); }
+.loadlink-message-route { position:absolute; display:block; width:38%; height:28%; border:2px dashed currentColor; border-left:0; border-bottom:0; border-radius:0 100% 0 0; }
+.loadlink-message-route.route-one { left:8%; top:14%; transform:rotate(9deg); }
+.loadlink-message-route.route-two { right:8%; top:42%; transform:rotate(190deg); }
+
+.loadlink-message-loader { min-height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:32px 20px; text-align:center; overflow:hidden; }
+.loadlink-message-loader.is-full { min-height:100svh; }
+.loadlink-message-loader.is-inline { min-height:260px; }
+.loadlink-message-loader-art { position:relative; width:min(620px,92vw); height:230px; border:1px solid rgba(246,184,0,.38); background:linear-gradient(180deg,rgba(246,184,0,.08),transparent 60%); overflow:hidden; }
+.loadlink-message-loader.is-inline .loadlink-message-loader-art { width:min(420px,88vw); height:150px; }
+.loadlink-loader-skyline { position:absolute; inset:auto 0 24% 0; height:35%; opacity:.16; background:linear-gradient(90deg,transparent 2%,currentColor 2% 9%,transparent 9% 12%,currentColor 12% 20%,transparent 20% 24%,currentColor 24% 30%,transparent 30% 36%,currentColor 36% 48%,transparent 48% 54%,currentColor 54% 65%,transparent 65% 72%,currentColor 72% 82%,transparent 82%); clip-path:polygon(0 100%,0 45%,8% 45%,8% 15%,17% 15%,17% 58%,28% 58%,28% 25%,42% 25%,42% 66%,56% 66%,56% 8%,70% 8%,70% 50%,83% 50%,83% 30%,94% 30%,94% 100%); }
+.loadlink-truck-sketch { color:#f6b800; width:72%; height:auto; }
+.loadlink-message-loader-art .loadlink-truck-sketch { position:absolute; left:14%; bottom:18%; animation:loadlink-truck-drive 2.8s cubic-bezier(.45,0,.3,1) infinite; filter:drop-shadow(0 10px 18px rgba(0,0,0,.22)); }
+.loadlink-message-loader.is-inline .loadlink-truck-sketch { width:66%; }
+.loadlink-truck-label { fill:currentColor; stroke:none; font-size:7px; font-weight:900; letter-spacing:1.2px; }
+.loadlink-loader-road { position:absolute; left:0; right:0; bottom:16%; height:2px; background:rgba(246,184,0,.42); }
+.loadlink-loader-road span { position:absolute; top:8px; width:54px; height:3px; background:#f6b800; animation:loadlink-road-move 1.2s linear infinite; }
+.loadlink-loader-road span:nth-child(1){left:8%;}.loadlink-loader-road span:nth-child(2){left:42%;animation-delay:-.4s}.loadlink-loader-road span:nth-child(3){left:76%;animation-delay:-.8s}
+.loadlink-message-loader-copy { margin-top:24px; max-width:520px; }
+.loadlink-message-loader-copy p { color:#b88900; font-size:10px; font-weight:950; letter-spacing:.22em; }
+.loadlink-message-loader-copy h1 { margin-top:8px; font-size:clamp(1.5rem,6vw,2.6rem); line-height:1; font-weight:950; letter-spacing:-.045em; }
+.loadlink-message-loader-copy span { display:block; margin-top:10px; font-size:13px; font-weight:650; opacity:.58; }
+.loadlink-loader-dots { display:flex; gap:7px; margin-top:20px; }
+.loadlink-loader-dots i { width:7px; height:7px; border-radius:999px; background:#f6b800; animation:loadlink-loader-dot 1.15s ease-in-out infinite; }
+.loadlink-loader-dots i:nth-child(2){animation-delay:.14s}.loadlink-loader-dots i:nth-child(3){animation-delay:.28s}
+@keyframes loadlink-truck-drive { 0%{transform:translateX(-12%) translateY(0)} 45%{transform:translateX(8%) translateY(-2px)} 100%{transform:translateX(-12%) translateY(0)} }
+@keyframes loadlink-road-move { from{transform:translateX(120px);opacity:0} 20%{opacity:1} to{transform:translateX(-120px);opacity:0} }
+@keyframes loadlink-loader-dot { 0%,100%{transform:translateY(0);opacity:.3} 50%{transform:translateY(-5px);opacity:1} }
+@media (prefers-reduced-motion: reduce) { .loadlink-message-loader-art .loadlink-truck-sketch,.loadlink-loader-road span,.loadlink-loader-dots i{animation:none!important} }
